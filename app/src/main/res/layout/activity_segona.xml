<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".SegonaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitolSegona"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titol_detall"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etDetallNom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_nom"
            android:inputType="textPersonName"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etDetallCognom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_cognom"
            android:inputType="textPersonName"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etDetallAdreca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_adreca"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etDetallTelefon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_telefon"
            android:inputType="phone"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etDetallMail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_mail"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etDetallDataNaixement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_data_naixement"
            android:inputType="date"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnAcceptar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_acceptar"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnCancelar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_cancelar"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnEsborrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_esborrar"
            android:backgroundTint="@android:color/holo_red_dark"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>
